# 复制为 .env 使用；.env 不入库
APP_ENV=dev
APP_PORT=8080
# 本地开发：连接 self_project/common 的通用 PostgreSQL 实例（端口 15432）
# 云主机部署：使用 docker-compose.prod.yml 内的 postgres 容器
DATABASE_URL=postgres://tongpin:tongpin@localhost:15432/tongpin?sslmode=disable
JWT_SECRET=dev-secret-change-me
# 契合提示灰度阈值：匹配池活跃用户低于此值不开匹配（本地测试设为 0 或 2）
MATCH_POOL_THRESHOLD=500

# LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
